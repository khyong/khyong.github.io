@inproceedings{kim2024fixed,
  title     = {Fixed Non-negative Orthogonal Classifier: Inducing Zero-mean Neural Collapse with Feature Dimension Separation},
  author    = {Kim, Hoyong and Kim, Kangil},
  booktitle = {International Conference on Learning Representations (ICLR)},
  year      = {2024},
  abbr      = {ICLR},
  selected  = {true},
  bibtex_show = {true},
  preview   = {fnoc.jpg},
  html      = {https://openreview.net/forum?id=F4bmOrmUwc},
  pdf       = {https://openreview.net/pdf?id=F4bmOrmUwc},
  slides    = {slides_iclr2024.pdf},
  video     = {https://iclr.cc/virtual/2024/poster/19083},
  abstract  = {Fixed classifiers in deep networks induce neural collapse toward a simplex equiangular tight frame. We study what happens when the fixed classifier is not a simplex and introduce the fixed non-negative orthogonal classifier, which achieves global optimality in the layer-peeled model while inducing zero-mean neural collapse and feature dimension separation, with benefits for continual and imbalanced learning.}
}

