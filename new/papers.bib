@inproceedings{kim2026balancing,
  title     = {Balancing Mixed Labels: Mixup meets Neural Collapse in Imbalanced Learning},
  author    = {Kim, Hoyong and Kim, Kangil},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  year      = {2026},
  abbr      = {NeurIPS},
  selected  = {true},
  bibtex_show = {true},
  preview   = {balancing_mixed_labels.png},
  abstract  = {We extend the analysis of Neural Collapse to Mixup under imbalanced settings and show that minority collapse in Mixup arises not only from imbalanced singleton labels but also from mixed labels. Balancing mixed labels and interpreting them as singletons significantly alleviates minority collapse and improves performance on standard imbalanced benchmarks.}
}

